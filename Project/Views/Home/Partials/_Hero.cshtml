<section class="hero-section">

    <div class="hero-overlay"></div>

    <div class="hero-left">
        <h1>Професионален автосервиз и диагностика</h1>

        <p>
            Качествени ремонти, модерна диагностика и пълна грижа за Вашия автомобил.
            Бързо, професионално и надеждно обслужване.
        </p>

        <a asp-controller="Home" asp-action="Service" class="hero-cta">
            Други услуги
        </a>
    </div>

    <div class="hero-right">
        <div class="hero-form-wrapper">
            <h3>Бърза заявка</h3>
            <div id="hero-error" class="hero-error"></div>

            <form id="heroRequestForm" asp-controller="ServiceRequests" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Име *</label>
                    <input type="text" name="ClientName" required placeholder="Вашето име">
                </div>

                <div class="form-group">
                    <label>Телефон *</label>
                    <input type="tel" name="Phone" required placeholder="+359 88 123 4567">
                </div>

                <div class="form-group">
                    <label>Имейл</label>
                    <input type="email" name="Email" placeholder="email@example.com">
                    <small style="color: #999; font-size: 12px;">Ще получите потвърждение на този имейл</small>
                </div>

                <div class="form-group">
                    <label>Автомобил (марка, модел, година) *</label>
                    <input type="text" id="CarInfo" required placeholder="Например: BMW X5 2020">
                    <input type="hidden" name="Brand" id="Brand">
                    <input type="hidden" name="Model" id="Model">
                    <input type="hidden" name="Year" id="Year">
                </div>

                <!-- Скрито VIN поле (не е задължително в бърза форма) -->
                <input type="hidden" name="VIN" value="">

                <div class="form-group">
                    <label>Вид услуга *</label>
                    <select name="ServiceType" required>
                        <option value="">-- Изберете --</option>
                        <option value="Ремонт">Ремонт</option>
                        <option value="Диагностика">Диагностика</option>
                        <option value="Безопасност">Проверка на безопасност</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Кратко описание *</label>
                    <textarea name="Description" required placeholder="Например: спукана гума, странен шум при спиране..." rows="2"></textarea>
                </div>

                <button type="submit" class="hero-submit">
                    Изпрати заявка
                </button>

            </form>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("heroRequestForm");
        const errorBox = document.getElementById("hero-error");
        const submitButton = form.querySelector("button[type='submit']");
        let isSubmitting = false;

        form.addEventListener("submit", function (e) {
            // Предотвратяваме множествено изпращане
            if (isSubmitting) {
                e.preventDefault();
                console.log("Form already submitting, prevented duplicate submission");
                return;
            }

            // Обработка на CarInfo полето преди изпращане
            const carInfoField = document.getElementById('CarInfo');
            const carInfo = carInfoField ? carInfoField.value.trim() : '';
            
            if (carInfo) {
                const parts = carInfo.split(/\s+/);
                
                if (parts.length >= 2) {
                    const lastPart = parts[parts.length - 1];
                    const yearMatch = lastPart.match(/^(19|20)\d{2}$/);
                    
                    if (yearMatch) {
                        document.getElementById('Year').value = yearMatch[0];
                        document.getElementById('Brand').value = parts[0];
                        document.getElementById('Model').value = parts.slice(1, -1).join(' ') || parts[1] || '';
                    } else {
                        document.getElementById('Brand').value = parts[0];
                        document.getElementById('Model').value = parts.slice(1).join(' ');
                        document.getElementById('Year').value = '';
                    }
                } else {
                    document.getElementById('Brand').value = parts[0] || '';
                    document.getElementById('Model').value = '';
                    document.getElementById('Year').value = '';
                }
            }

            let isValid = true;
            errorBox.style.display = "none";
            errorBox.innerHTML = "";

            // Clear old errors
            form.querySelectorAll(".input-error")
                .forEach(el => el.classList.remove("input-error"));

            const name = form.querySelector("input[name='ClientName']");
            const phone = form.querySelector("input[name='Phone']");
            const service = form.querySelector("select[name='ServiceType']");
            const description = form.querySelector("textarea[name='Description']");

            // Validation
            if (name && name.value.trim() === "") {
                isValid = false;
                name.classList.add("input-error");
            }

            if (phone && phone.value.trim() === "") {
                isValid = false;
                phone.classList.add("input-error");
            }

            if (service && service.value.trim() === "") {
                isValid = false;
                service.classList.add("input-error");
            }

            if (carInfoField && carInfoField.value.trim() === "") {
                isValid = false;
                carInfoField.classList.add("input-error");
            }

            if (description && description.value.trim() === "") {
                isValid = false;
                description.classList.add("input-error");
            }

            if (!isValid) {
                e.preventDefault();
                errorBox.innerHTML = "Моля, попълнете всички задължителни полета.";
                errorBox.style.display = "block";
                return;
            }

            // Ако валидацията е успешна, маркираме че формата се изпраща
            isSubmitting = true;
            submitButton.disabled = true;
            submitButton.textContent = "Изпращане...";
            console.log("Form validation passed, submitting...");
        });
    });
</script>
