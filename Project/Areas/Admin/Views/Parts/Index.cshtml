@model List<Project.Models.Entities.Part>

@{
    ViewData["Title"] = "Управление на части";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-warning">Каталог с части</h2>
            <p class="text-white mb-0">Централно хранилище на всички части за преизползване в ремонти и услуги</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-warning" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse">
                <i class="bi bi-funnel"></i> Филтри
            </button>
            <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#createPartModal">
                <i class="bi bi-plus-circle"></i> Добави част
            </button>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="collapse mb-4" id="filterCollapse">
        <div class="card bg-dark border-warning">
            <div class="card-body">
                <h5 class="text-warning mb-3"><i class="bi bi-funnel"></i> Филтриране на части</h5>
                <form id="filter-form">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label text-white">Име на част</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" 
                                   id="filter-name" placeholder="Търси по име">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-white">Категория</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" 
                                   id="filter-category" placeholder="Категория">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-white">OEM номер</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" 
                                   id="filter-oem" placeholder="OEM номер">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-white">Производител</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" 
                                   id="filter-manufacturer" placeholder="Производител">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-white">Марка автомобил</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" 
                                   id="filter-brand" placeholder="Марка">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-white">Модел автомобил</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" 
                                   id="filter-model" placeholder="Модел">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-white">Статус</label>
                            <select class="form-select bg-dark text-white border-secondary" id="filter-status">
                                <option value="">Всички</option>
                                <option value="true">Активни</option>
                                <option value="false">Неактивни</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-white">Наличност</label>
                            <select class="form-select bg-dark text-white border-secondary" id="filter-stock">
                                <option value="">Всички</option>
                                <option value="inStock">На склад</option>
                                <option value="lowStock">Ниска наличност</option>
                                <option value="outOfStock">Изчерпано</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-warning flex-fill">
                                    <i class="bi bi-search"></i> Търси
                                </button>
                                <button type="button" class="btn btn-outline-secondary flex-fill" id="clear-filters">
                                    <i class="bi bi-x-circle"></i> Изчисти
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Results count -->
    <div class="mb-3 text-end">
        <span class="text-white">Общо: <strong class="text-warning" id="parts-count">@Model.Count</strong> части</span>
    </div>

    <!-- Parts Table -->
    <div class="crm-section">
        <div class="crm-section-header">
            <h5 class="crm-section-title">
                <i class="bi bi-box-seam"></i> Части
            </h5>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" id="parts-table">
                <thead>
                    <tr>
                        <th>Име</th>
                        <th>Категория</th>
                        <th>OEM</th>
                        <th>Производител</th>
                        <th>Цена</th>
                        <th>Наличност</th>
                        <th>Статус</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="8" class="text-center">
                            <div class="spinner-border text-warning" role="status">
                                <span class="visually-hidden">Зареждане...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_CreatePartModalPartial", new Part())
    @await Html.PartialAsync("_EditPartModalPartial", new Part())

</div>

@section Scripts {
    <script>
        async function loadParts(filters = {}) {
            try {
                // Build query string from filters
                const params = new URLSearchParams();
                for (const [key, value] of Object.entries(filters)) {
                    if (value) params.append(key, value);
                }
                
                const url = '/api/admin/parts' + (params.toString() ? '?' + params.toString() : '');
                const response = await fetch(url);
                if (!response.ok) throw new Error('Failed to load');
                
                const data = await response.json();
                renderTable(data);
            } catch (error) {
                console.error('Error loading parts:', error);
                showAlert('Грешка при зареждане на частите', 'danger');
            }
        }

        function renderTable(data) {
            const tbody = document.querySelector('#parts-table tbody');
            tbody.innerHTML = '';

            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-white">Няма части</td></tr>';
                document.getElementById('parts-count').textContent = '0';
                return;
            }

            document.getElementById('parts-count').textContent = data.length;

            data.forEach(part => {
                const stockBadge = getStockBadge(part.stockQuantity);
                const statusBadge = part.isActive 
                    ? '<span class="badge bg-success"><i class="bi bi-check-circle"></i> Активна</span>'
                    : '<span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Неактивна</span>';
                
                const description = part.description 
                    ? `<small class="d-block text-white" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${part.description}</small>`
                    : '';

                const category = part.category 
                    ? `<span class="badge bg-secondary">${part.category}</span>`
                    : '<span class="text-white">-</span>';

                const row = `
                    <tr data-id="${part.id}">
                        <td>
                            <strong>${part.name}</strong>
                            ${description}
                        </td>
                        <td>${category}</td>
                        <td>${part.oemNumber || '-'}</td>
                        <td>${part.manufacturer || '-'}</td>
                        <td><strong class="text-warning">${part.price.toFixed(2)} лв.</strong></td>
                        <td>${stockBadge}</td>
                        <td>${statusBadge}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-warning edit-part-btn" 
                                    data-id="${part.id}"
                                    data-bs-toggle="modal" 
                                    data-bs-target="#editPartModal"
                                    title="Редактирай">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }

        function getStockBadge(quantity) {
            if (quantity > 5) {
                return `<span class="badge bg-success">${quantity} бр.</span>`;
            } else if (quantity > 0) {
                return `<span class="badge bg-warning text-dark">${quantity} бр.</span>`;
            } else {
                return '<span class="badge bg-danger">Изчерпано</span>';
            }
        }

        function showAlert(message, type) {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            const container = document.createElement('div');
            container.innerHTML = alertHtml;
            document.querySelector('.container-fluid').insertBefore(container.firstElementChild, document.querySelector('.container-fluid').firstChild);
            
            setTimeout(() => {
                container.remove();
            }, 5000);
        }

        // Filter form submission
        document.getElementById('filter-form').addEventListener('submit', (e) => {
            e.preventDefault();
            
            const filters = {
                name: document.getElementById('filter-name').value,
                category: document.getElementById('filter-category').value,
                oem: document.getElementById('filter-oem').value,
                manufacturer: document.getElementById('filter-manufacturer').value,
                brand: document.getElementById('filter-brand').value,
                model: document.getElementById('filter-model').value,
                isActive: document.getElementById('filter-status').value,
                stock: document.getElementById('filter-stock').value
            };
            
            loadParts(filters);
        });

        // Clear filters
        document.getElementById('clear-filters').addEventListener('click', () => {
            document.getElementById('filter-form').reset();
            loadParts();
        });

        // Handle Edit button click
        document.addEventListener('click', async function(e) {
            if (e.target.closest('.edit-part-btn')) {
                e.preventDefault();
                const btn = e.target.closest('.edit-part-btn');
                const partId = btn.dataset.id;
                
                try {
                    const response = await fetch(`/api/admin/parts/${partId}`);
                    if (!response.ok) throw new Error('Failed to load part');
                    
                    const part = await response.json();
                    
                    // Populate the form
                    document.getElementById('edit-part-id').value = part.id;
                    document.getElementById('edit-name').value = part.name;
                    document.getElementById('edit-category').value = part.category || '';
                    document.getElementById('edit-manufacturer').value = part.manufacturer || '';
                    document.getElementById('edit-oem-number').value = part.oemNumber || '';
                    document.getElementById('edit-image-url').value = part.imageUrl || '';
                    document.getElementById('edit-price').value = part.price;
                    document.getElementById('edit-stock-quantity').value = part.stockQuantity;
                    document.getElementById('edit-is-active').checked = part.isActive;
                    document.getElementById('edit-description').value = part.description || '';
                    
                } catch (error) {
                    console.error('Error loading part:', error);
                    alert('Грешка при зареждане на данните');
                }
            }
        });

        // Load on page ready
        document.addEventListener('DOMContentLoaded', loadParts);
    </script>
}
