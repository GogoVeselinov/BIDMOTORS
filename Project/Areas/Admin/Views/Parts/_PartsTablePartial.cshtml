@model IEnumerable<Project.Models.Entities.Part>

<div class="crm-section mt-4">

    <div class="crm-section-header">
        <h5 class="crm-section-title">
            <i class="bi bi-box-seam"></i> Части
        </h5>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-white">
            <i class="bi bi-inbox" style="font-size: 42px;"></i>
            <p class="mt-2">Няма добавени части</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Име</th>
                        <th>Категория</th>
                        <th>OEM</th>
                        <th>Производител</th>
                        <th>Цена</th>
                        <th>Наличност</th>
                        <th>Статус</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var part in Model)
                    {
                        <tr data-id="@part.Id">

                            <td>
                                <strong>@part.Name</strong>
                                @if (!string.IsNullOrEmpty(part.Description))
                                {
                                    <small class="d-block text-white" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @part.Description
                                    </small>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(part.Category))
                                {
                                    <span class="badge bg-secondary">@part.Category</span>
                                }
                                else
                                {
                                    <span class="text-white">-</span>
                                }
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(part.OemNumber) ? "-" : part.OemNumber)
                            </td>

                            <td>@(part.Manufacturer ?? "-")</td>

                            <td>
                                <strong class="text-warning">@part.Price.ToString("F2") лв.</strong>
                            </td>

                            <td>
                                @if (part.StockQuantity > 5)
                                {
                                    <span class="badge bg-success">@part.StockQuantity бр.</span>
                                }
                                else if (part.StockQuantity > 0)
                                {
                                    <span class="badge bg-warning text-dark">@part.StockQuantity бр.</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Изчерпано</span>
                                }
                            </td>

                            <td>
                                @if (part.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Активна
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-x-circle"></i> Неактивна
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-warning edit-part-btn" data-id="@part.Id"
                                    data-bs-toggle="modal" data-bs-target="#editPartModal" title="Редактирай">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>

<style>
/* HEADER */
.crm-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid #2a2a2a;
}

.crm-section-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--yellow);
    margin: 0;
    letter-spacing: 0.3px;
}

/* TABLE */
.table {
    --bs-table-bg: transparent;
    --bs-table-striped-bg: #1a1a1a;
    --bs-table-hover-bg: #222;
}

.table thead th {
    color: var(--yellow);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    border-bottom: 2px solid var(--yellow);
    padding: 14px 12px;
}

.table tbody td {
    padding: 16px 12px;
    vertical-align: middle;
    font-size: 14px;
}

/* NAME COLUMN */
.table tbody td strong {
    font-size: 15px;
    font-weight: 700;
    color: white;
}

.table tbody small {
    font-size: 12px;
    color: var(--text-white);
}

/* PRICE */
.table tbody td:nth-child(4) strong {
    color: var(--yellow);
    font-size: 15px;
}

/* BADGES */
.badge {
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 12px;
    font-weight: 600;
}

.badge.bg-success {
    background: rgba(76, 175, 80, 0.15) !important;
    color: #4caf50;
    border: 1px solid #4caf50;
}

.badge.bg-warning {
    background: rgba(255, 193, 7, 0.15) !important;
    color: #ffc107;
    border: 1px solid #ffc107;
}

.badge.bg-danger {
    background: rgba(244, 67, 54, 0.15) !important;
    color: #f44336;
    border: 1px solid #f44336;
}

/* CAR INFO */
.table tbody td:nth-child(6) {
    font-size: 13px;
    color: #ddd;
}

.table tbody td .text-white {
    font-size: 13px;
}

/* ACTION BUTTON */
.edit-part-btn {
    border-radius: 6px;
    padding: 6px 10px;
    transition: 0.2s ease;
}

.edit-part-btn:hover {
    background: var(--yellow);
    color: black;
    border-color: var(--yellow);
}

/* ROW HOVER */
.table tbody tr {
    transition: background-color 0.2s ease;
}

.table tbody tr:hover {
    background: #1f1f1f;
}

</style>