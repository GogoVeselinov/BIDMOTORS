@model List<Project.Models.Entities.Client>
@using System.Linq

<div class="crm-table-wrapper">
    <div class="table-responsive">
        <table class="table table-dark table-hover crm-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Име</th>
                    <th>Имейл</th>
                    <th>Телефон</th>
                    <th>Тип</th>
                    <th>Автомобили</th>
                    <th>Ремонти</th>
                    <th>Създаден</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td>@client.Id.ToString().Substring(0, 4)</td>

                            <td>
                                <strong>@client.Name</strong>
                            </td>

                            <td>
                                <a href="mailto:@client.Email" class="crm-link">
                                    @client.Email
                                </a>
                            </td>

                            <td>
                                <a href="tel:@client.Phone" class="crm-link">
                                    @client.Phone
                                </a>
                            </td>

                            <td>
                                @if (client.IsGuest)
                                {
                                    <span class="crm-badge secondary">Гост</span>
                                }
                                else
                                {
                                    <span class="crm-badge success">Регистриран</span>
                                }
                            </td>

                            <td>
                                <span class="crm-counter">@client.Cars.Count</span>
                            </td>

                            <td>
                                <span class="crm-counter warning">@client.Repairs.Count</span>
                            </td>

                            <td>
                                @client.CreatedOn.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-light"
                                    title="Детайли">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="crm-table-empty">
                            <i class="bi bi-people"></i>
                            <p>Няма потребители в системата</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* PAGE HEADER */
    .crm-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        border-bottom: 2px solid var(--yellow);
        padding-bottom: 12px;
    }

    .crm-page-header h2 {
        margin: 0;
        color: #f1f1f1;
    }

    .crm-page-actions {
        display: flex;
        gap: 10px;
    }

    /* TABLE WRAPPER */
    .crm-table-wrapper {
        border: 1px solid #2a2a2a;
        background: #141414;
    }

    /* TABLE */
    .crm-table {
        margin: 0 !important;
        background-color: #141414 !important;
    }

    .crm-table thead {
        background-color: #121212 !important;
        border-bottom: 2px solid var(--yellow) !important;
    }

    .crm-table thead th {
        color: var(--yellow) !important;
        font-size: 12px;
        text-transform: uppercase;
        padding: 14px;
        border: none !important;
        background-color: #121212 !important;
    }

    .crm-table tbody tr {
        border-bottom: 1px solid #2a2a2a !important;
        background-color: #141414 !important;
    }

    .crm-table tbody tr:hover {
        background-color: #1a1a1a !important;
    }

    .crm-table tbody td {
        padding: 14px;
        border: none !important;
        color: #e5e5e5 !important;
        background-color: transparent !important;
        vertical-align: middle;
    }

    /* LINKS */
    .crm-link {
        color: #8ab4f8;
        text-decoration: none;
    }

    .crm-link:hover {
        color: var(--yellow);
    }

    /* BADGES */
    .crm-badge {
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 12px;
        background: rgba(246, 210, 1, 0.15);
        color: var(--yellow);
    }

    .crm-badge.success {
        background: rgba(76, 175, 80, 0.15);
        color: #4caf50;
    }

    .crm-badge.secondary {
        background: rgba(158, 158, 158, 0.15);
        color: #bdbdbd;
    }

    /* COUNTERS */
    .crm-counter {
        display: inline-block;
        min-width: 28px;
        text-align: center;
        padding: 4px 8px;
        border-radius: 10px;
        background: rgba(138, 180, 248, 0.15);
        color: #8ab4f8;
        font-size: 12px;
    }

    .crm-counter.warning {
        background: rgba(246, 210, 1, 0.15);
        color: var(--yellow);
    }

    /* EMPTY */
    .crm-table-empty {
        text-align: center;
        padding: 40px;
        color: #888;
    }

    .crm-table-empty i {
        font-size: 32px;
        display: block;
        margin-bottom: 10px;
    }
</style>