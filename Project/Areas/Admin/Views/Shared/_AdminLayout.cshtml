<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin | BIDMOTORS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin/admin-layout.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body class="admin-body">

    <div class="admin-wrapper">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar">

            <div class="admin-logo">
                BID<span>MOTORS</span>
            </div>

            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Табло
                </a>

                <a asp-area="Admin" asp-controller="ServiceTypes" asp-action="Index">
                    <i class="bi bi-tools"></i> Видове услуги
                </a>

                <a asp-area="Admin" asp-controller="Parts" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Части
                </a>

                <a asp-area="Admin" asp-controller="Employees" asp-action="Index">
                    <i class="bi bi-people"></i> Служители
                </a>

                <a asp-area="Admin" asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-gear"></i> Настройки
                </a>
            </nav>

        </aside>

        <!-- MAIN -->
        <div class="admin-main">

            <!-- TOPBAR -->
            <header class="admin-topbar">

                <div class="topbar-left">
                    <h1 class="admin-page-title">
                        @ViewData["Title"]
                    </h1>
                </div>

                <div class="topbar-right">

                    <!-- Notifications (future) -->
                    <button class="topbar-icon">
                        <i class="bi bi-bell"></i>
                    </button>

                    <!-- User -->
                    <div class="admin-user">
                        <i class="bi bi-person-circle"></i>
                        <span>Администратор</span>
                    </div>

                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Logout"
                       class="logout-btn">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>

                </div>
            </header>

            <!-- CONTENT -->
            <main class="admin-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    
    <!-- SignalR Connection for Admin Notifications -->
    <script>
        const notificationConnection = new signalR.HubConnectionBuilder()
            .withUrl("/notifyHub")
            .configureLogging(signalR.LogLevel.Information)
            .build();

        notificationConnection.on("ReceiveNotification", function (data) {
            console.log("Notification received:", data);
            
            const message = typeof data === 'string' ? data : data.message;
            const type = typeof data === 'object' ? data.type : null;
            
            // Показване на toast известие
            showToast(message, type);
            
            // Ако сме на Index страницата, презареждаме таблицата
            if (typeof loadRequests === 'function') {
                loadRequests();
            }
        });

        notificationConnection.start()
            .then(() => {
                console.log("SignalR connected for admin notifications");
            })
            .catch(err => {
                console.error("SignalR connection error:", err);
            });

        // Toast notification function
        function showToast(message, type) {
            const toastContainer = document.getElementById('toast-container') || createToastContainer();
            
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type === 'NewServiceRequest' ? 'info' : 'warning'} border-0`;
            toast.setAttribute('role', 'alert');
            toast.setAttribute('aria-live', 'assertive');
            toast.setAttribute('aria-atomic', 'true');
            
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-bell-fill me-2"></i>${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            
            toastContainer.appendChild(toast);
            const bsToast = new bootstrap.Toast(toast, { delay: 5000 });
            bsToast.show();
            
            toast.addEventListener('hidden.bs.toast', () => {
                toast.remove();
            });
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'toast-container position-fixed top-0 end-0 p-3';
            container.style.zIndex = '9999';
            document.body.appendChild(container);
            return container;
        }
    </script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
