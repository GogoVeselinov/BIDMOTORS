<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin | BIDMOTORS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin/admin-layout.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" 
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body class="admin-body">

    <div class="admin-wrapper">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar">

            <div class="admin-logo">
                BID<span>MOTORS</span>
            </div>

            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Табло
                </a>

                <a asp-area="Admin" asp-controller="ServiceTypes" asp-action="Index">
                    <i class="bi bi-tools"></i> Видове услуги
                </a>

                <a asp-area="Admin" asp-controller="Parts" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Части
                </a>

                <a asp-area="Admin" asp-controller="Employees" asp-action="Index">
                    <i class="bi bi-person-badge"></i> Служители
                </a>

                <a asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i> Потребители
                </a>

                <a asp-area="Admin" asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-gear"></i> Настройки
                </a>
            </nav>

        </aside>

        <!-- MAIN -->
        <div class="admin-main">

            <!-- TOPBAR -->
            <header class="admin-topbar">

                <div class="topbar-left">
                    <h1 class="admin-page-title">
                        @ViewData["Title"]
                    </h1>
                </div>

                <div class="topbar-right">

                    <!-- Notifications -->
                    <div class="dropdown">
                        <button class="topbar-icon dropdown-toggle" type="button" id="adminNotifDropdown" 
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell"></i>
                            <span id="notifCounter" class="admin-notif-badge d-none">0</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end admin-notif-dropdown" aria-labelledby="adminNotifDropdown">
                            <li class="dropdown-header">Известия</li>
                            <div id="notifList" class="admin-notif-list">
                                <p class="text-center text-muted small p-2">Няма известия</p>
                            </div>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-center small" href="/Notifications/All">
                                    Виж всички
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- User -->
                    <div class="admin-user">
                        <i class="bi bi-person-circle"></i>
                        <span>@Context.Session.GetString("UserName")</span>
                    </div>

                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Logout"
                       class="logout-btn"
                       title="Изход">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>

                </div>
            </header>

            <!-- CONTENT -->
            <main class="admin-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
@RenderSection("Scripts", required: false)

    <script>
        // Зареждане на броя непрочетени известия при стартиране
        @if (Context.Session.GetString("UserId") != null)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                loadNotificationCount();
                loadRecentNotifications();
                
                // Refresh every 30 seconds
                setInterval(loadNotificationCount, 30000);
                setInterval(loadRecentNotifications, 30000);

                // Маркирай известията като прочетени когато се отвори dropdown-а
                const notifDropdown = document.getElementById('adminNotifDropdown');
                if (notifDropdown) {
                    notifDropdown.addEventListener('show.bs.dropdown', function() {
                        markNotificationsAsRead();
                    });
                }
            });

            function loadNotificationCount() {
                const counter = document.getElementById('notifCounter');
                if (!counter) return; // Елементът не съществува на тази страница
                
                fetch('/Notifications/GetUnreadCount')
                    .then(response => response.json())
                    .then(data => {
                        if (data.count > 0) {
                            counter.innerText = data.count;
                            counter.classList.remove('d-none');
                            console.log('[Notifications] Unread count:', data.count);
                        } else {
                            counter.classList.add('d-none');
                        }
                    })
                    .catch(err => console.error('Error loading notification count:', err));
            }

            function loadRecentNotifications() {
                const list = document.getElementById('notifList');
                if (!list) return; // Елементът не съществува на тази страница
                
                fetch('/Notifications/GetRecent')
                    .then(response => response.json())
                    .then(data => {
                        if (data.notifications && data.notifications.length > 0) {
                            list.innerHTML = '';
                            data.notifications.forEach(notif => {
                                const item = document.createElement('a');
                                item.classList.add('dropdown-item', 'notif-item');
                                if (!notif.isRead) {
                                    item.classList.add('unread');
                                }
                                item.href = '/Notifications/All';
                                item.innerHTML = `
                                    <div class="d-flex flex-column">
                                        <small class="text-muted">${notif.createdOn}</small>
                                        <span>${notif.message}</span>
                                    </div>
                                `;
                                list.appendChild(item);
                            });
                        } else {
                            list.innerHTML = '<p class="text-center text-white small p-2">Няма известия</p>';
                        }
                    })
                    .catch(err => console.error('Error loading notifications:', err));
            }

            function markNotificationsAsRead() {
                fetch('/Notifications/MarkAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        console.log('[Notifications] Marked', data.count, 'notifications as read');
                        // Обнови брояча след 500ms
                        setTimeout(() => {
                            loadNotificationCount();
                            loadRecentNotifications();
                        }, 500);
                    }
                })
                .catch(err => console.error('Error marking notifications as read:', err));
            }
            </text>
        }

        // SignalR connection за real-time известия
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notifyHub")
            .build();

        connection.on("ReceiveNotification", function (message) {
            console.log('[SignalR Admin] Received notification:', message);
            
            // 1) Update counter
            loadNotificationCount();
            loadRecentNotifications();

            // 2) Show browser notification
            if ("Notification" in window && Notification.permission === "granted") {
                new Notification("BIDMOTORS - Admin", {
                    body: message,
                    icon: "/img/logo.png"
                });
            }
            
            // 3) Bell animation
            const bell = document.querySelector('#adminNotifDropdown i');
            if (bell) {
                bell.classList.add('bi-bell-fill');
                bell.classList.remove('bi-bell');
                setTimeout(() => {
                    bell.classList.remove('bi-bell-fill');
                    bell.classList.add('bi-bell');
                }, 3000);
            }
        });

        connection.start()
            .then(() => {
                console.log('[SignalR Admin] Connected successfully');
                
                // Request browser notification permission
                if ("Notification" in window && Notification.permission === "default") {
                    Notification.requestPermission();
                }
            })
            .catch(err => console.error('[SignalR Admin] Connection error:', err));
    </script>
</body>
</html>
