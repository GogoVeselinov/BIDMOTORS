@model Project.Models.Entities.Repair

@{
    ViewData["Title"] = "Детайли за ремонт";
    var settings = ViewBag.Settings as Project.Models.Entities.PriceSettings;
    var availableParts = ViewBag.AvailableParts as List<Project.Models.Entities.Part>;
}

<!-- PAGE HEADER -->
<div class="crm-page-header">
    <div>
        <h2>Ремонт #@Model.Id.ToString().Substring(0, 8)</h2>
        <p class="text-white">Детайли и управление на ремонт</p>
    </div>

    <div class="crm-page-actions">
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-arrow-left"></i> Назад
        </a>

        @if (Model.Status == "Completed" && Model.InvoiceNumber != null)
        {
            <a asp-action="GenerateInvoice" asp-route-id="@Model.Id" class="btn btn-success" target="_blank">
                <i class="bi bi-file-earmark-pdf"></i> Фактура
            </a>
        }
        else if (Model.Status == "Active")
        {
            <form asp-action="RemoveDuplicates" asp-route-id="@Model.Id" method="post" class="d-inline me-2">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-sm" title="Премахва дублирани части">
                    <i class="bi bi-trash"></i> Изчисти дубликати
                </button>
            </form>
            <form asp-action="RecalculateCosts" asp-route-id="@Model.Id" method="post" class="d-inline me-2">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-info btn-sm" title="Преизчислява цените">
                    <i class="bi bi-calculator"></i> Преизчисли
                </button>
            </form>
            <form asp-action="CompleteRepair" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning" onclick="return confirm('Сигурни ли сте, че искате да завършите ремонта?')">
                    <i class="bi bi-check-circle"></i> Завърши ремонт
                </button>
            </form>
        }
    </div>
</div>

<div class="row">
    <!-- LEFT COLUMN -->
    <div class="col-lg-8">

        <!-- BASIC INFO -->
        <div class="crm-section">
            <h5 class="crm-section-title">Основна информация</h5>

            <div class="crm-info-grid">
                <div>
                    <label>Клиент</label>
                    <span><strong>@Model.Client.Name</strong></span>
                </div>

                <div>
                    <label>Автомобил</label>
                    <span>@Model.Car.Brand @Model.Car.Model (@Model.Car.RegistrationNumber)</span>
                </div>

                <div>
                    <label>Статус</label>
                    <span class="crm-badge">@Model.Status</span>
                </div>

                <div>
                    <label>Заявка</label>
                    <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@Model.ServiceRequest.Id" class="crm-link">
                        #@Model.ServiceRequest.Id.ToString().Substring(0, 8)
                    </a>
                </div>

                <div>
                    <label>Създаден</label>
                    <span>@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</span>
                </div>

                @if (Model.FinishedOn.HasValue)
                {
                    <div>
                        <label>Завършен</label>
                        <span>@Model.FinishedOn.Value.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                }
            </div>

            <div class="mt-3">
                <label>Заявка от клиента</label>
                <p class="crm-description">@Model.WorkDescription</p>
            </div>
        </div>

        <!-- MANAGER NOTES -->
        <div class="crm-section">
            <h5 class="crm-section-title">
                <i class="bi bi-file-text"></i> Описание за фактура
            </h5>

            @if (Model.Status == "Active")
            {
                <form asp-action="UpdateManagerNotes" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Описание от мениджъра (показва се във фактурата)</label>
                        <textarea name="managerNotes" class="form-control" rows="4" placeholder="Напишете описание на извършената работа...">@Model.ManagerNotes</textarea>
                        <small class="text-white">Това описание ще се покаже във фактурата вместо заявката на клиента.</small>
                    </div>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save"></i> Запази описание
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-info">
                    @if (!string.IsNullOrEmpty(Model.ManagerNotes))
                    {
                        <p>@Model.ManagerNotes</p>
                    }
                    else
                    {
                        <em>Няма добавено описание от мениджъра.</em>
                    }
                </div>
            }
        </div>

        <!-- LABOR HOURS -->
        @if (Model.Status == "Active")
        {
            <div class="crm-section">
                <h5 class="crm-section-title">
                    <i class="bi bi-clock-history"></i> Работни часове
                </h5>

                <form asp-action="UpdateLaborHours" asp-route-id="@Model.Id" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label class="form-label">Часове работа</label>
                        <input type="number" name="hours" class="form-control" step="0.5" value="@Model.LaborHours" required />
                        <small class="text-white">Цена за час: @(settings?.LaborCostPerHour ?? 0) лв</small>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Обнови
                        </button>
                    </div>
                </form>

                <div class="mt-3 crm-cost-line">
                    <span>Цена работа:</span>
                    <strong>@Model.LaborCost.ToString("F2") лв</strong>
                </div>
            </div>
        }
        else
        {
            <div class="crm-section">
                <h5 class="crm-section-title">
                    <i class="bi bi-clock-history"></i> Работни часове
                </h5>
                <div class="crm-cost-line">
                    <span>Часове работа:</span>
                    <strong>@Model.LaborHours.ToString("F1") ч</strong>
                </div>
                <div class="crm-cost-line">
                    <span>Цена работа:</span>
                    <strong>@Model.LaborCost.ToString("F2") лв</strong>
                </div>
            </div>
        }

        <!-- USED PARTS -->
        <div class="crm-section">
            <h5 class="crm-section-title">
                <i class="bi bi-gear"></i> Използвани части
                @if (Model.Status == "Active")
                {
                    <button class="btn btn-sm btn-warning float-end" data-bs-toggle="modal" data-bs-target="#addPartModal">
                        <i class="bi bi-plus"></i> Добави част
                    </button>
                }
            </h5>

            @if (Model.UsedParts.Any())
            {
                <table class="table table-dark table-hover crm-table">
                    <thead>
                        <tr>
                            <th>Част</th>
                            <th>Количество</th>
                            <th>Базова цена</th>
                            <th>Ед. цена @if(settings != null && settings.PartsMarkupPercent > 0) { <small class="text-warning">(+@settings.PartsMarkupPercent%)</small> }</th>
                            <th>Обща цена</th>
                            <th style="width: 80px;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var up in Model.UsedParts)
                        {
                            var basePrice = settings != null && settings.PartsMarkupPercent > 0 
                                ? up.UnitPriceAtMoment / (1 + settings.PartsMarkupPercent / 100) 
                                : up.UnitPriceAtMoment;
                            <tr>
                                <td>@up.Part.Name</td>
                                <td>@up.QuantityUsed</td>
                                <td class="text-white">@basePrice.ToString("F2") лв</td>
                                <td>@up.UnitPriceAtMoment.ToString("F2") лв</td>
                                <td><strong>@up.TotalPrice.ToString("F2") лв</strong></td>
                                <td>
                                    @if (Model.Status == "Active")
                                    {
                                        <button type="button" class="btn btn-danger btn-sm" onclick="removePart('@up.Id')" title="Премахни част">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="crm-cost-line">
                    <span>Цена части:</span>
                    <strong>@Model.PartsCost.ToString("F2") лв</strong>
                </div>
            }
            else
            {
                <p class="text-white">Няма добавени части</p>
            }
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-lg-4">
        <div class="crm-section">
            <h5 class="crm-section-title">Изчисления</h5>

            <div class="crm-cost-line">
                <span>Работа:</span>
                <span>@Model.LaborCost.ToString("F2") лв</span>
            </div>

            <div class="crm-cost-line">
                <span>Части:</span>
                <span>@Model.PartsCost.ToString("F2") лв</span>
            </div>

            <div class="crm-cost-line border-top pt-2">
                <span>Междинна сума:</span>
                <span>@((Model.LaborCost + Model.PartsCost).ToString("F2")) лв</span>
            </div>

            <div class="crm-cost-line">
                <span>ДДС (@(settings?.VATPercent ?? 20)%):</span>
                <span>@(((Model.LaborCost + Model.PartsCost) * (settings?.VATPercent ?? 20) / 100).ToString("F2")) лв</span>
            </div>

            <div class="crm-cost-line border-top pt-2">
                <span><strong>Обща цена:</strong></span>
                <span class="crm-total-price">@Model.TotalCost.ToString("F2") лв</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.InvoiceNumber))
            {
                <div class="mt-3 p-3" style="background: #1a1a1a; border-radius: 4px;">
                    <small class="text-white">Номер на фактура</small>
                    <div><code>@Model.InvoiceNumber</code></div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Part Modal -->
@if (Model.Status == "Active")
{
    <div class="modal fade" id="addPartModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="background: #1a1a1a; border: 1px solid #3a3a3a;">
                <div class="modal-header">
                    <h5 class="modal-title text-warning">
                        <i class="bi bi-box-seam"></i> Добави част от каталога
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Search bar -->
                    <div class="mb-3">
                        <label class="form-label">Търсене в каталога</label>
                        <input type="text" id="partSearchInput" class="form-control" 
                               placeholder="Търси по име, категория, OEM номер..." 
                               onkeyup="filterParts()" />
                    </div>

                    <!-- Parts selection list -->
                    <div class="mb-3">
                        <label class="form-label">Избери част</label>
                        <div id="partsListContainer" style="max-height: 300px; overflow-y: auto; border: 1px solid #3a3a3a; border-radius: 4px;">
                            @if (availableParts != null && availableParts.Any())
                            {
                                @foreach (var part in availableParts)
                                {
                                    <div class="part-item p-3 border-bottom" 
                                         style="cursor: pointer; border-color: #2a2a2a !important;" 
                                         data-part-id="@part.Id"
                                         data-part-name="@part.Name"
                                         data-part-category="@part.Category"
                                         data-part-oem="@part.OemNumber"
                                         data-part-price="@part.Price"
                                         data-part-stock="@part.StockQuantity"
                                         onclick="selectPart(this)">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong class="text-white">@part.Name</strong>
                                                @if (!string.IsNullOrEmpty(part.Category))
                                                {
                                                    <span class="badge bg-secondary ms-2">@part.Category</span>
                                                }
                                                @if (!string.IsNullOrEmpty(part.OemNumber))
                                                {
                                                    <div class="text-white small">OEM: @part.OemNumber</div>
                                                }
                                            </div>
                                            <div class="text-end">
                                                <div class="text-warning fw-bold">@part.Price.ToString("F2") лв</div>
                                                @if (part.StockQuantity > 5)
                                                {
                                                    <small class="text-success">На склад: @part.StockQuantity</small>
                                                }
                                                else if (part.StockQuantity > 0)
                                                {
                                                    <small class="text-warning">На склад: @part.StockQuantity</small>
                                                }
                                                else
                                                {
                                                    <small class="text-danger">Изчерпано</small>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-3 text-center text-white">
                                    <i class="bi bi-inbox"></i>
                                    <p class="mb-0 mt-2">Няма налични части в каталога</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Selected part info -->
                    <div id="selectedPartInfo" class="alert alert-info d-none">
                        <strong>Избрана част:</strong> <span id="selectedPartName"></span>
                    </div>

                    <!-- Quantity input -->
                    <div class="mb-3">
                        <label class="form-label">Количество</label>
                        <input type="number" id="quantityInput" class="form-control" min="1" value="1" />
                        <input type="hidden" id="selectedPartId" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отказ</button>
                    <button type="button" class="btn btn-warning" onclick="addPartToRepair()">Добави</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .crm-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        border-bottom: 2px solid var(--yellow);
        padding-bottom: 12px;
    }

    .crm-page-header h2 {
        margin: 0;
        color: #f1f1f1;
    }

    .crm-page-actions {
        display: flex;
        gap: 10px;
    }

    .crm-section {
        border: 1px solid #2a2a2a;
        background: #141414;
        padding: 20px;
        margin-bottom: 24px;
        border-radius: 8px;
    }

    .crm-section-title {
        color: var(--yellow);
        margin-bottom: 16px;
        font-weight: 600;
    }

    .crm-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px 32px;
    }

    .crm-info-grid label {
        font-size: 12px;
        color: #888;
        display: block;
    }

    .crm-description {
        background: #1a1a1a;
        padding: 12px;
        border-radius: 4px;
        color: #e5e5e5;
        margin: 0;
    }

    .crm-cost-line {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #2a2a2a;
    }

    .crm-cost-line:last-child {
        border-bottom: none;
    }

    .crm-total-price {
        font-size: 20px;
        font-weight: bold;
        color: var(--yellow);
    }

    .crm-badge {
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 12px;
        background: rgba(246, 210, 1, 0.15);
        color: var(--yellow);
    }

    .crm-link {
        color: #8ab4f8;
        text-decoration: none;
    }

    .crm-link:hover {
        color: var(--yellow);
    }

    .form-label {
        color: #888;
        font-size: 14px;
    }

    .form-control, .form-select {
        background: #1a1a1a;
        border: 1px solid #3a3a3a;
        color: #e5e5e5;
    }

    .form-control:focus, .form-select:focus {
        background: #1a1a1a;
        border-color: var(--yellow);
        color: #e5e5e5;
        box-shadow: 0 0 0 0.2rem rgba(246, 210, 1, 0.15);
    }

    .crm-table {
        margin: 0 !important;
        background-color: #1a1a1a !important;
    }

    .crm-table thead {
        background-color: #121212 !important;
        border-bottom: 2px solid var(--yellow) !important;
    }

    .crm-table thead th {
        color: var(--yellow) !important;
        font-size: 12px;
        text-transform: uppercase;
        border: none !important;
    }

    .crm-table tbody tr {
        border-bottom: 1px solid #2a2a2a !important;
        background-color: #1a1a1a !important;
    }

    .crm-table tbody td {
        border: none !important;
        color: #e5e5e5 !important;
    }

    .part-item {
        transition: background-color 0.2s;
    }

    .part-item:hover {
        background-color: #252525 !important;
    }
</style>

<script>
    // Filter parts by search input
    function filterParts() {
        const searchInput = document.getElementById('partSearchInput').value.toLowerCase();
        const partItems = document.querySelectorAll('.part-item');

        partItems.forEach(item => {
            const name = item.getAttribute('data-part-name').toLowerCase();
            const category = (item.getAttribute('data-part-category') || '').toLowerCase();
            const oem = (item.getAttribute('data-part-oem') || '').toLowerCase();
            
            const matches = name.includes(searchInput) || 
                          category.includes(searchInput) || 
                          oem.includes(searchInput);
            
            item.style.display = matches ? 'block' : 'none';
        });
    }

    // Select a part from the list
    function selectPart(element) {
        // Remove previous selection
        document.querySelectorAll('.part-item').forEach(item => {
            item.style.backgroundColor = '';
            item.style.borderLeft = '';
        });

        // Highlight selected item
        element.style.backgroundColor = '#2a2a2a';
        element.style.borderLeft = '3px solid #f6d201';

        // Get part data
        const partId = element.getAttribute('data-part-id');
        const partName = element.getAttribute('data-part-name');
        const partPrice = element.getAttribute('data-part-price');

        // Update hidden fields and info
        document.getElementById('selectedPartId').value = partId;
        document.getElementById('selectedPartName').textContent = partName + ' - ' + parseFloat(partPrice).toFixed(2) + ' лв';
        document.getElementById('selectedPartInfo').classList.remove('d-none');
    }

    async function addPartToRepair() {
        const partId = document.getElementById('selectedPartId').value;
        const quantity = parseInt(document.getElementById('quantityInput').value);

        if (!partId || !quantity) {
            alert('Моля изберете част и количество');
            return;
        }

        try {
            const response = await fetch('/Admin/Repairs/AddPart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    repairId: '@Model.Id',
                    partId: partId,
                    quantity: quantity
                })
            });

            const result = await response.json();

            if (result.success) {
                location.reload();
            } else {
                alert(result.message);
            }
        } catch (error) {
            alert('Грешка при добавяне на частта');
        }
    }

    async function removePart(usedPartId) {
        if (!confirm('Сигурни ли сте, че искате да премахнете тази част? Наличността ще бъде възстановена.')) {
            return;
        }

        try {
            const response = await fetch('/Admin/Repairs/RemovePart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    usedPartId: usedPartId
                })
            });

            const result = await response.json();

            if (result.success) {
                location.reload();
            } else {
                alert(result.message);
            }
        } catch (error) {
            alert('Грешка при премахване на частта');
        }
    }

    // Reset modal when closed
    document.getElementById('addPartModal')?.addEventListener('hidden.bs.modal', function () {
        document.getElementById('partSearchInput').value = '';
        document.getElementById('selectedPartId').value = '';
        document.getElementById('quantityInput').value = '1';
        document.getElementById('selectedPartInfo').classList.add('d-none');
        document.querySelectorAll('.part-item').forEach(item => {
            item.style.backgroundColor = '';
            item.style.borderLeft = '';
            item.style.display = 'block';
        });
    });
</script>

@Html.AntiForgeryToken()
