@{
    ViewData["Title"] = "Видове услуги";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Scripts {
    <script src="~/js/admin/service-types-api.js"></script>
    <script src="~/js/admin/service-types-index.js"></script>
}

<div class="container-fluid service-types-page">

    <!-- HEADER -->
    <div class="service-types-header">
        <div>
            <h2>Видове услуги</h2>
            <p class="text-white">
                Управление на типовете услуги и работните процеси към тях
            </p>
        </div>

        <a asp-action="Create" class="btn btn-warning">
            <i class="bi bi-plus-lg"></i> Нов тип услуга
        </a>
    </div>

    <!-- ALERTS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- NOTIFICATION CONTAINER -->
    <div class="notification-container"></div>

    <!-- TABLE -->
    <div class="crm-section text-white">
        <div id="service-types-container">
            <div class="text-center text-white py-5">
                <div class="spinner-border text-warning" role="status">
                    <span class="visually-hidden">Зареждане...</span>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
/* PAGE */
.service-types-page {
    padding: 30px;
}

/* HEADER */
.service-types-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    border-bottom: 2px solid var(--yellow);
    padding-bottom: 15px;
}

.service-types-header h2 {
    margin: 0;
    color: #f1f1f1;
}

.service-types-header p {
    margin: 4px 0 0;
    font-size: 14px;
    color: #9a9a9a;
}

/* REMOVE CARD FEEL */
.crm-section {
    background: transparent;
    border: none;
    padding: 0;
}

/* TABLE BASE */
#service-types-container table {
    width: 100%;
    border-collapse: collapse;
    background: #141414;
    color: #e5e5e5;
}

/* HEADER */
#service-types-container thead {
    background: #1c1c1c;
    border-bottom: 2px solid var(--yellow);
}

#service-types-container th {
    padding: 14px 16px;
    font-size: 13px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--yellow);
    border: none;
    background: transparent;
}

/* BODY */
#service-types-container td {
    padding: 16px;
    border-bottom: 1px solid #2a2a2a;
    background: transparent;
    color: #e0e0e0;
}

/* HOVER */
#service-types-container tbody tr:hover {
    background: rgba(255, 215, 0, 0.04);
}

/* STATUS BADGES */
#service-types-container .status-badge {
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

/* BUTTONS */
#service-types-container .btn {
    background: transparent;
    border-color: #555;
    color: #ddd;
}

#service-types-container .btn:hover {
    border-color: var(--yellow);
    color: var(--yellow);
}

/* LOADER */
#service-types-container .spinner-border {
    width: 3rem;
    height: 3rem;
}

</style>