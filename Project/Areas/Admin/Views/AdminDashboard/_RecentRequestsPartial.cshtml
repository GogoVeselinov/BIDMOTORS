@model List<Project.Models.Entities.ServiceRequest>

<div class="row mt-4">
    <div class="col-12">
        <section class="crm-section">

            <div class="crm-section-header">
                <h5 class="crm-section-title">Последни заявки</h5>
                <a asp-area="Admin" asp-controller="ServiceRequests" asp-action="Index" class="crm-section-link">
                    Виж всички
                </a>
            </div>

            <div class="crm-section-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover">
                            <thead>
                                <tr>
                                    <th>Клиент</th>
                                    <th>Автомобил</th>
                                    <th>Тип услуга</th>
                                    <th>Статус</th>
                                    <th>Дата</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model)
                                {
                                    <tr>
                                        <td>@request.Client.Name</td>
                                        <td>@request.Car.Brand @request.Car.Model</td>
                                        <td>@request.ServiceType</td>
                                        <td>
                                            <span class="badge bg-warning">@request.Status</span>
                                        </td>
                                        <td>@request.CreatedOn.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@request.Id" 
                                               class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-white">Няма заявки за показване</p>
                }
            </div>

        </section>
    </div>
</div>


<style>
    /* CRM SECTION */
    .crm-section {
        background: #1a1a1a;
        border: 1px solid #2a2a2a;
        border-radius: 10px;
        padding: 20px 24px;
    }

    /* HEADER */
    .crm-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid #2a2a2a;
    }

    .crm-section-title {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: var(--yellow);
    }

    .crm-section-link {
        font-size: 14px;
        color: var(--yellow);
        text-decoration: none;
        transition: 0.2s ease;
    }

    .crm-section-link:hover {
        color: white;
        text-decoration: underline;
    }

    /* BODY */
    .crm-section-body {
        padding-top: 10px;
    }
</style>